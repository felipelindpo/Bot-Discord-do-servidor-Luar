    "youtube-dl-exec": "^3.1.19"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@discordjs/opus@0.11.0": true,
    "ffmpeg-static@5.3.0": true,
